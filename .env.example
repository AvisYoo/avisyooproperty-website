# Copy to .env.local. Development uses private .local JSON files without DATABASE_URL.
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=60143194105
# Generate a bcrypt hash with npm run admin:hash; NEVER use a plain text password here.
ADMIN_PASSWORD_HASH=
# Generate at least 32 random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Production requires a configured PostgreSQL database, persistent rate limits and HTTPS.
# Optional verified social profile; do not put a generic Facebook homepage here.
NEXT_PUBLIC_FACEBOOK_URL=
